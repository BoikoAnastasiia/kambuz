  "steps": [
    {
      "order": 1,
      "text": "Включить духовку разогреваться на 200°.",
      "timestamp": 345
    },
    {
      "order": 2,
      "text": "Выложить филе трески на противень.",
      "timestamp": 371
    },
    {
      "order": 3,
      "text": "Удалить кости из рыбы, если они есть.",
      "timestamp": 388
    },
    {
      "order": 4,
      "text": "Посолить рыбу.",
      "timestamp": 404
    },
    {
      "order": 5,
      "text": "Поперчить рыбу.",
      "timestamp": 410
    },
    {
      "order": 6,
      "text": "Взять соус песто и обильно растереть по каждому кусочку рыбы.",
      "timestamp": 421
    },
    {
      "order": 7,
      "text": "Взять помидоры и удалить у них попку.",
      "timestamp": 483
    },
    {
      "order": 8,
      "text": "Нарезать помидоры кольцами толщиной примерно по сантиметру.",
      "timestamp": 503
    },
    {
      "order": 9,
      "text": "Выложить кольца помидоров сверху на рыбу.",
      "timestamp": 514
    },
    {
      "order": 10,
      "text": "Нарезать моцареллу такой же толщины, как помидоры.",
      "timestamp": 542
    },
    {
      "order": 11,
      "text": "Выложить моцареллу внахлёст к помидорам поверх рыбы.",
      "timestamp": 556
    },
    {
      "order": 12,
      "text": "Слегка подсолить сверху ещё раз.",
      "timestamp": 603
    },
    {
      "order": 13,
      "text": "Включить в разогретой до 200° духовке режим конвекции вверх-вниз.",
      "timestamp": 619
    },
    {
      "order": 14,
      "text": "Поставить противень с рыбой в духовку на нижний уровень на 15-20 минут, пока не растает и не подрумянится моцарелла.",
      "timestamp": 626
