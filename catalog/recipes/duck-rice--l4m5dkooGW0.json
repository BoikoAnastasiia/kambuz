  "steps": [
    {
      "order": 1,
      "text": "Поставить рис запекаться в духовке.",
      "timestamp": 496
    },
    {
      "order": 2,
      "text": "Обжарить утиное филе со всех сторон на холодной сковороде без масла до хрустящей корочки.",
      "timestamp": 557
    },
    {
      "order": 3,
      "text": "Снять утку со сковороды, когда корочка готова, но мясо ещё сырое внутри.",
      "timestamp": 591
    },
    {
      "order": 4,
      "text": "Оставить утиный жир в сковороде для дальнейшего использования, не выбрасывать его.",
      "timestamp": 619
    },
    {
      "order": 5,
      "text": "Нарезать утку на кусочки.",
      "timestamp": 889
    },
    {
      "order": 6,
      "text": "Разогреть сковороду с утиным жиром.",
      "timestamp": 897
    },
    {
      "order": 7,
      "text": "Обжарить овощи (лук, морковь) на утином жире.",
      "timestamp": 900
    },
    {
      "order": 8,
      "text": "Добавить нарезанную утку к овощам и обжарить вместе.",
      "timestamp": 903
    },
    {
      "order": 9,
      "text": "Заправить сладким чили, соевым соусом и чесноком.",
      "timestamp": 905
    },
    {
      "order": 10,
      "text": "Добавить готовый рис в сковороду, если он помещается, иначе перемешать рис отдельно.",
      "timestamp": 910
    },
    {
      "order": 11,
      "text": "Смешать утку с овощами и соусом с рисом в большом противне.",
      "timestamp": 949
    },
    {
      "order": 12,
      "text": "Хорошо перемешать, чтобы соус распределился по всему рису.",
      "timestamp": 982
    },
    {
      "order": 13,
      "text": "Попробовать готовое блюдо.",
      "timestamp": 1002
    }
