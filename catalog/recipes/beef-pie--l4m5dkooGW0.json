    {
      "order": 10,
      "text": "Вылить половину теста в форму.",
      "timestamp": 757
    },
    {
      "order": 11,
      "text": "Разровнять тесто по форме.",
      "timestamp": 771
    },
    {
      "order": 12,
      "text": "Взять обжаренную говядину для начинки.",
      "timestamp": 803
    },
    {
      "order": 13,
      "text": "Выложить начинку из говядины на тесто и распределить её равномерно.",
      "timestamp": 810
