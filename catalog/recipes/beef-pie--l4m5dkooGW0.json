  "steps": [
    {
      "order": 1,
      "text": "Взять говядину и решить использовать её как начинку для пирога, обжарив отдельно с овощами, а затем запечь в тесте.",
      "timestamp": 506
    },
    {
      "order": 2,
      "text": "Нарезать говядину для начинки.",
      "timestamp": 585
