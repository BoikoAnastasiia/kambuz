    {
      "order": 3,
      "text": "Начать готовить тесто на заливной пирог: добавить 750 г кефира.",
      "timestamp": 683
    },
    {
      "order": 4,
      "text": "Добавить 6 яиц в тесто.",
      "timestamp": 700
    },
    {
      "order": 5,
      "text": "Посолить (примерно чайная ложка соли) и поперчить тесто по вкусу.",
      "timestamp": 708
    },
    {
      "order": 6,
      "text": "Перемешать тесто.",
      "timestamp": 717
    },
    {
      "order": 7,
      "text": "Добавить 2 чайные ложки разрыхлителя в муку.",
      "timestamp": 722
    },
    {
      "order": 8,
      "text": "Всыпать 500 г муки в тесто и перемешать до однородности (консистенция жидкой сметаны).",
      "timestamp": 725
    },
    {
      "order": 9,
      "text": "Подготовить форму для выпечки, застелить пергаментной бумагой.",
      "timestamp": 746
