# .env.example
ANTHROPIC_API_KEY=
# MongoDB Atlas connection string, for the pipeline, the worker and the website
MONGODB_URI=
# Website sign-in (Auth.js + Google). AUTH_SECRET: any long random string (openssl rand -base64 32)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated emails that get the admin role (only admins can add videos)
ADMIN_EMAILS=
